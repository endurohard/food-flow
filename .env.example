# Database
DATABASE_URL=postgresql://foodflow:foodflow_secret@localhost:5432/foodflow
POSTGRES_USER=foodflow
POSTGRES_PASSWORD=foodflow_secret
POSTGRES_DB=foodflow

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://foodflow:foodflow_secret@localhost:5672
RABBITMQ_DEFAULT_USER=foodflow
RABBITMQ_DEFAULT_PASS=foodflow_secret

# Интервал досылки событий воркером outbox в order-service, мс
OUTBOX_INTERVAL_MS=5000
# false — баллы лояльности начисляются только вручную через API,
# без реакции на order.completed / order.delivered
AUTO_EARN_POINTS=true

# Kong
KONG_DATABASE=postgres
KONG_PG_HOST=kong-database
KONG_PG_USER=kong
KONG_PG_PASSWORD=kong_secret
KONG_PG_DATABASE=kong

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Ключ шифрования чужих секретов (пароль подключения к ВАТС и подобные).
# Генерировать: openssl rand -hex 32
# Без него роут настроек ВАТС отдаёт 503 — пароль открытым не сохраняется.
# ВНИМАНИЕ: ключ нельзя терять и нельзя менять после сохранения паролей —
# сохранённые значения станут нечитаемыми, их придётся вводить заново.
ENCRYPTION_KEY=

# Services Ports
USER_SERVICE_PORT=3001
RESTAURANT_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003
DELIVERY_SERVICE_PORT=3004

# API Gateway
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
KONG_MANAGER_PORT=8002

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Logging
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601

# Node Environment
NODE_ENV=development

# Telegram Bot Service
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
TELEGRAM_WEBHOOK_URL=
OPENAI_API_KEY=

# Сервис-сервисные вызовы (общий секрет).
# Нужен для: расхода по накладной в finance-service и
# списания ингредиентов по техкартам при закрытии заказа.
INTERNAL_TOKEN=

# Автосписание ингредиентов по техкартам при продаже блюда.
# false — склад ведётся вручную (только производство и движения).
AUTO_DEDUCT_STOCK=true
