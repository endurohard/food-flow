{
  "name": "foodflow-print-agent",
  "version": "1.0.0",
  "description": "Агент печати FoodFlow: забирает задания с сервера и печатает на кухонный принтер",
  "main": "src/index.js",
  "bin": {
    "foodflow-print-agent": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/",
    "build:win": "npx --yes @yao-pkg/pkg . --targets node20-win-x64 --output dist/foodflow-print-agent.exe",
    "build:linux": "npx --yes @yao-pkg/pkg . --targets node20-linux-x64 --output dist/foodflow-print-agent-linux",
    "build:mac": "npx --yes @yao-pkg/pkg . --targets node20-macos-x64 --output dist/foodflow-print-agent-macos"
  },
  "pkg": {
    "assets": [],
    "scripts": ["src/**/*.js"]
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "license": "MIT"
}
