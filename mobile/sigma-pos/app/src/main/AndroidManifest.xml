<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Очередь продаж должна доезжать после перезагрузки терминала -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Драйвер ККТ и приложение кассы — отдельные пакеты;
         для Android 11+ нужен явный queries, иначе они "не видны". -->
    <queries>
        <package android:name="ru.atol.drivers10.service" />
        <package android:name="ru.atol.tap.cashier" />
        <intent>
            <action android:name="ru.atol.drivers10.service.PROCESS_TASK" />
        </intent>
    </queries>

    <application
        android:name=".PosApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.FoodFlowPos"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FoodFlowPos">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Перезапуск очереди синхронизации после загрузки устройства -->
        <receiver
            android:name=".sync.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
